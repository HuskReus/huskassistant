# Copia este archivo como .env y rellena tus datos. NUNCA compartas tu .env.
# Token de tu bot (te lo da @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=
# Tu chat_id personal (te lo da @userinfobot en Telegram). Te hace el dueño.
TELEGRAM_CHAT_ID=
# Opcional: activa lenguaje natural y el razonamiento con IA del radar
ANTHROPIC_API_KEY=
# Opcional: hora UTC del briefing diario
BRIEFING_HOUR_UTC=13
# Opcional: chat_ids de invitados separados por coma
GUEST_CHAT_IDS=
# Opcional: clave para la PWA si la expones fuera de tu red
AGENT_API_TOKEN=
